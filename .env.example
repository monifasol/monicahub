# Resend (same pattern as Vecina Digital)
RESEND_API_KEY=re_xxxxxxxx

# Where messages are delivered (default in code: monism@gmail.com)
CONTACT_TO_EMAIL=monism@gmail.com

# Verified sender in Resend (reuses vecinadigital.com for now)
CONTACT_FROM_EMAIL=Mónica Saiz <hola@vecinadigital.com>

# /lab no tiene contraseña. Sigue sin indexar (robots noindex).
# Seeklient tiene la suya: SEEKLIENT_ACCESS_TOKEN, en el proyecto Seeklient.

# Origen del deploy de Seeklient (sin barra final).
# En Vercel: https://<tu-proyecto>.vercel.app
# SEEKLIENT_ORIGIN=https://seeklient.vercel.app
