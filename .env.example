# Forward Email API token (Basic auth username, empty password)
FORWARDEMAIL_API_TOKEN=

# Where messages are delivered (default in code: moni.sm@gmail.com)
CONTACT_TO_EMAIL=moni.sm@gmail.com

# Alias that already exists in Forward Email
CONTACT_FROM_EMAIL=Mónica Saiz <hola@monicasaiz.com>

# /lab no tiene contraseña. Sigue sin indexar (robots noindex).
# Seeklient tiene la suya: SEEKLIENT_ACCESS_TOKEN, en el proyecto Seeklient.

# Origen del deploy de Seeklient (sin barra final).
# En Vercel: https://<tu-proyecto>.vercel.app
# SEEKLIENT_ORIGIN=https://seeklient.vercel.app
